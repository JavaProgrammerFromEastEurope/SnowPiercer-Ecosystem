{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Life Support authenticated checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payload",
    "hmac_sha256"
  ],
  "properties": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "registry_fingerprint",
        "sequence",
        "event_hash",
        "state_sha256"
      ],
      "properties": {
        "format": {
          "const": "snowpiercer.life.checkpoint.v1"
        },
        "registry_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "event_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "state_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "hmac_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
