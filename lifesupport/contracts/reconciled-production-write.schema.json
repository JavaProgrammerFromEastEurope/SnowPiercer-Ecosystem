{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LIFE-CORE-017 request",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "request_id",
        "component_id",
        "next_state",
        "event_id",
        "reason"
      ],
      "properties": {
        "op": {
          "const": "transition"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "component_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "next_state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "request_id"
      ],
      "properties": {
        "op": {
          "const": "receipt"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "enum": [
            "health",
            "snapshot"
          ]
        }
      }
    }
  ]
}
